# =============================================================================
# CampusFix Environment Configuration
# =============================================================================

# 1. Supabase PostgreSQL & Auth Credentials
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. AI APIs (Server-Side Only — NEVER expose in frontend or NEXT_PUBLIC_)
# Groq: Powers Multilingual Chat (openai/gpt-oss-120b), Whisper STT (whisper-large-v3-turbo), and Orpheus TTS (canopylabs/orpheus-v1-english)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini: Powers Primary CampusFix AI Assistant (models/gemini-4-hydrogen)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# 3. Cloudflare Turnstile CAPTCHA Configuration
# Public site key (safe for client-side rendering)
# For local development testing, Cloudflare provides "Always Passes" test keys:
# Test Site Key: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Turnstile Secret Key (server-side only for token validation)
# Test Secret Key: 1x00000000000000000000000000000000BB
TURNSTILE_SECRET_KEY=1x00000000000000000000000000000000BB
